# ScholarFlow – local environment template
# ---------------------------------------------------------------
# Copy this file to `.env` (same directory) and fill in your real
# values. `.env` is git-ignored, so your secrets never get
# committed. On Render, set these same keys in:
#   Dashboard → scholarflow-backend → Environment → Add Env Var
# The backend uses python-dotenv (`load_dotenv()`), which reads
# `.env` only when present; on Render the variables you set in
# the dashboard take precedence automatically.

# ── Supabase (auth, DB, storage) ──────────────────────────────────
# Get these from https://app.supabase.com → Project → Settings → API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_API_KEY=YOUR-SUPABASE-ANON-OR-SERVICE-KEY
# Optional: service-role key (skips Row Level Security). Use only
# in backend code. Never expose to the Flutter client.
SUPABASE_SERVICE_ROLE_KEY=

# ── Gemini (LLM used by all agents) ───────────────────────────────
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=YOUR-GEMINI-API-KEY

# Optional model override (defaults to gemini-2.5-flash)
MODEL_NAME=gemini-2.5-flash

# Optional: cap how many top-cited papers feed into the summary
TOP_SUMMARY_PAPERS=5

# ── Semantic Scholar (paper search) ──────────────────────────────
# Optional but recommended – raises rate limits.
# Get one at https://www.semanticscholar.org/product/api#api-key
SEMANTIC_SCHOLAR_API_KEY=
